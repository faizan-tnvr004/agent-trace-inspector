# Copy to .env and fill in. Never commit .env.

# --- LLM provider ------------------------------------------------------------
# Google Gemini API key, used by the workflow harness (corpus generation) and by
# the evaluation judge. Obtain from https://aistudio.google.com/apikey
# Free tier is sufficient for this project; see README limitations.
GEMINI_API_KEY=

# Model used by the workflow harness when generating the trace corpus.
CORPUS_MODEL=gemini-3.5-flash-lite

# Model used by the evaluation judge. Must be identical across both study
# conditions; only the input content differs between conditions.
JUDGE_MODEL=gemini-3.5-flash-lite

# Requests per minute cap applied to all provider calls, to stay inside the
# free tier quota. Set to 0 to disable throttling.
LLM_RPM_LIMIT=10

# --- Storage -----------------------------------------------------------------
# SQLite database file. Regenerable from the committed corpus, so it is
# gitignored.
TRACE_DB_PATH=data/traces.db

# Directory holding the committed corpus of trace JSON files.
CORPUS_DIR=data/corpus

# --- Extraction --------------------------------------------------------------
# Sentence embedding model used for evidence survival and claim linking.
# CPU only, no GPU dependency.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Frontend ----------------------------------------------------------------
# Base URL the React app uses to reach the backend.
VITE_API_BASE_URL=http://localhost:8000

# --- PR review corpus (Phase 7) ----------------------------------------------
# GitHub token for the public pull request collection. Only needs public repo
# read access. The `gh` CLI token is used automatically if this is unset.
GITHUB_TOKEN=
